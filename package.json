{
  "name": "programmable-v4-launch",
  "version": "0.1.0",
  "private": true,
  "description": "Source-bound Programmable V4 launch contracts for Robinhood Chain Uniswap v4.",
  "license": "MIT",
  "scripts": {
    "build": "forge build --offline",
    "build:production": "forge build --offline --sizes",
    "build:pack-artifacts": "node scripts/build-pack-artifacts.mjs",
    "test": "forge test --offline -vvv",
    "test:fuzz": "forge test --offline --fuzz-runs 10000",
    "verify:distribution": "node distribution/verify-package.mjs",
    "fmt:check": "forge fmt --check",
    "sizes": "forge build --offline --sizes"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/uniswap-hooks": "1.1.1",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3"
  },
  "devDependencies": {
    "solc": "0.8.26"
  },
  "overrides": {
    "@openzeppelin/contracts": "$@openzeppelin/contracts",
    "@openzeppelin/uniswap-hooks": "$@openzeppelin/uniswap-hooks",
    "@uniswap/v4-core": "$@uniswap/v4-core",
    "@uniswap/v4-periphery": "$@uniswap/v4-periphery"
  }
}
